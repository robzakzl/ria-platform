#!/usr/bin/env bash
# Stack and check wrapper. Usage: ./dc up | down | reset | check quick|full | <any docker compose args>
set -euo pipefail
cd "$(dirname "$0")"

# The worktree's own .env decides which stack and ports this is; it beats a stale shell export.
if [[ -f .env ]]; then
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^(COMPOSE_PROJECT_NAME|[A-Z_]+_PORT)=(.*)$ ]] || continue
    key=${BASH_REMATCH[1]} val=${BASH_REMATCH[2]}
    if [[ -n ${!key+x} && ${!key} != "$val" ]]; then
      echo "dc: using $key from .env, not the exported value" >&2
    fi
    export "$key=$val"
  done < .env
fi

case "${1:-}" in
  up)
    shift
    exec docker compose up -d --build --wait "$@"
    ;;
  down)
    shift
    for arg in "$@"; do
      if [[ $arg == -v || $arg == --volumes ]]; then
        echo "dc: down keeps the database; use ./dc reset to wipe it" >&2
        exit 2
      fi
    done
    exec docker compose down "$@"
    ;;
  reset)
    read -r -p "Delete the local database for this stack? [y/N] " answer
    [[ $answer == y || $answer == Y ]] || exit 1
    exec docker compose down --volumes
    ;;
  check)
    shift
    exec scripts/check.sh "$@"
    ;;
  "")
    echo "usage: ./dc up | down | reset | check quick|full | <docker compose args>" >&2
    exit 2
    ;;
  *)
    exec docker compose "$@"
    ;;
esac
