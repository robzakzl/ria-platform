#!/usr/bin/env bash
# Stack and check wrapper. Usage: ./dc up | down | reset | check quick|full | <any docker compose args>
set -euo pipefail
cd "$(dirname "$0")"

# The worktree's own .env decides which stack and ports this is; it beats a stale shell export.
if [[ -f .env ]]; then
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    [[ $line =~ ^[[:space:]]*(export[[:space:]]+)?(COMPOSE_PROJECT_NAME|[A-Z_]+_PORT)[[:space:]]*=(.*)$ ]] || continue
    key=${BASH_REMATCH[2]} val=${BASH_REMATCH[3]}
    if [[ $val =~ ^[[:space:]]*\"(.*)\"[[:space:]]*$ || $val =~ ^[[:space:]]*\'(.*)\'[[:space:]]*$ ]]; then
      val=${BASH_REMATCH[1]}
    else
      val=${val%%[[:space:]]#*}
      val=${val//[[:space:]]/}
    fi
    [[ -n $val ]] || continue
    if [[ -n ${!key+x} && ${!key} != "$val" ]]; then
      echo "dc: using $key from .env, not the exported value" >&2
    fi
    export "$key=$val"
  done < .env
fi
export DC_WRAPPED=1

# down never deletes data, however it is spelled; ./dc reset is the only wipe.
refuse_volume_wipe() {
  local arg is_down=0
  for arg in "$@"; do [[ $arg == down ]] && is_down=1; done
  ((is_down)) || return 0
  for arg in "$@"; do
    if [[ $arg == --volumes* || $arg =~ ^-[a-zA-Z]*v ]]; then
      echo "dc: down keeps the database; use ./dc reset to wipe it" >&2
      exit 2
    fi
  done
}

case "${1:-}" in
  up)
    shift
    exec docker compose up -d --build --wait "$@"
    ;;
  down)
    refuse_volume_wipe "$@"
    shift
    exec docker compose down "$@"
    ;;
  reset)
    read -r -p "Delete the local database for this stack? [y/N] " answer
    [[ $answer == y || $answer == Y ]] || exit 1
    exec docker compose down --volumes
    ;;
  check)
    shift
    exec scripts/check.sh "$@"
    ;;
  "")
    echo "usage: ./dc up | down | reset | check quick|full | <docker compose args>" >&2
    exit 2
    ;;
  *)
    refuse_volume_wipe "$@"
    exec docker compose "$@"
    ;;
esac
