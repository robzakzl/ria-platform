# Copy to .env only to change a default; everything works without a .env.

# Local database login (local development only, not a real secret).
POSTGRES_USER=ria
POSTGRES_PASSWORD=ria
POSTGRES_DB=ria

# Host ports: set by the pool — never hand-assign in a Jaah worktree.
# Elsewhere the defaults apply (web 5173, API 8000, database 5432); uncomment one only if it is taken.
# WEB_PORT=
# API_PORT=
# DB_PORT=
# COMPOSE_PROJECT_NAME=
